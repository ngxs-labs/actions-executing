{
  "name": "ngxs-actions-executing",
  "scripts": {
    "start": "ng serve --port=4256",
    "build": "ng build ngxs-actions-executing --configuration production && yarn copy-readme",
    "copy-readme": "ts-node --project tsconfig.tools.json ./tools/copy-readme",
    "release": "standard-version --release-as patch",
    "build-integration": "ng build integration",
    "test": "jest --config ./jest.config.ts",
    "test:ci": "jest --config ./jest.config.ts --coverage",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --config ./jest.config.ts",
    "format": "prettier --write",
    "lint": "tslint '{src,integration}/**/*.ts' --project tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ngxs/logger-plugin": "^22.0.0",
    "@ngxs/store": "^22.0.0",
    "bootstrap": "^5.0.0",
    "core-js": "^3.6.0",
    "rxjs": "^6.5.3 || ^7.4.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-angular": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@ngxs/devtools-plugin": "^22.0.0",
    "@types/jest": "^30.0.0",
    "codelyzer": "^6.0.0",
    "colors": "^1.3.3",
    "cypress": "^3.4.1",
    "husky": "^9.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.0.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.0.0",
    "start-server-and-test": "^2.0.0",
    "ts-node": "^10.0.0",
    "typescript": "6.0.3"
  }
}
